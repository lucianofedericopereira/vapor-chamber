# Dependencies
node_modules/

# Build output
dist/

# Test coverage
coverage/

# Bench-run outputs
bench.txt

# A/B test baselines: each tests/*-ab.test.ts writes tests/__ref/<name>/ during
# a run and removes it in afterAll, so a commit made while the suite runs
# would pick them up.
tests/__ref/

# Test/coverage counts for stamp-docs (scripts/test-counts-reporter.mjs).
# Deliberately not committed: the counts depend on what else has run (8 files
# skip without dist/, 2 more tests skip under coverage), so the file would churn
# - prepublishOnly runs test:run before build. stamp-docs skips markers whose source is missing, so CI is unaffected;
# stamp locally after `npm run build && npm run test:coverage`.
docs/metrics.json

# Logs
*.log
npm-debug.log*

# Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# npm pack output
*.tgz

# Astro generated artifacts (examples/exo-astro)
.astro/

# Incremental / temp build state
*.tsbuildinfo
vite.config.*.timestamp-*

# Secrets - never commit
.env
.env.*
!.env.example

# Machine-local editor/agent settings
.claude/settings.local.json

# Local scratch notes (not part of the project)
rc1.txt
resume.txt

# Session handoff / working state (transient, machine-local)
HANDOFF.md
TODO.md

# Laravel example scaffold output (examples/laravel-app/setup.sh)
demo-app/

# Throwaway measurement scripts and probe tests. Every alignment cycle writes a
# few; they are evidence for a commit message, not part of the suite, and twice
# now one nearly landed as a tmp-*.test.ts. Give them a home that git ignores.
# At the ROOT, deliberately: under tests/ every tool that walks that directory
# found them and each needed its own exclude. See vitest.probes.config.ts.
.probes/

# The probe SFC the vue-tsc gap check wrote into the example. That script is
# gone (v1.22.0: the reshape removed the argument the gap needed), but the
# pattern stays - a killed run of any successor probe must still be unable to
# commit deliberately broken code into an example.
**/__vue_tsc_gap_probe.vue
