# Dependencies
node_modules/

# Build output
dist/

# Test coverage
coverage/

# Browser-suite attachments (screenshots Vitest writes on a run)
.vitest/

# Bench-run outputs
bench.txt

# A/B test baselines: each tests/*-ab.test.ts writes tests/__ref/<name>/ during
# a run and removes it in afterAll, so a commit made while the suite runs
# would pick them up.
tests/__ref/

# Test/coverage counts for stamp-docs (scripts/test-counts-reporter.mjs).
# Deliberately not committed: the counts depend on what else has run (files that
# read dist/ fail without it, and the timing-only tests skip under coverage), so
# the file would churn. stamp-docs skips markers whose source is missing, so CI
# is unaffected; stamp locally after `npm run build && npm run test:coverage`.
docs/metrics.json

# Logs
*.log
npm-debug.log*

# Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# npm pack output
*.tgz

# Astro generated artifacts (examples/apps/exo-astro)
.astro/

# Incremental / temp build state
*.tsbuildinfo
vite.config.*.timestamp-*

# Secrets - never commit
.env
.env.*
!.env.example

# Machine-local editor/agent settings (launch.json: a desktop preview's dev servers)
.claude/settings.local.json
.claude/launch.json

# Local scratch notes (not part of the project)
rc1.txt
resume.txt

# Session handoff / working state (transient, machine-local)
HANDOFF.md
TODO.md

# Laravel example scaffold output (examples/laravel/app/setup.sh): a whole
# Laravel app with its vendor/, which links back to this repo through Composer's
# path repository. Git ignoring it is not enough: the repo's own tree walkers
# skip it by name too (check-ascii, stamp-docs, the example tests, biome.json,
# the examples runner's watcher), or a walk into it never ends. Add a new
# walker to that list.
demo-app/

# The Composer package's install, if run at the root (composer.json is the
# package manifest; a library commits no lock).
/vendor/
/composer.lock

# Throwaway measurement scripts and probe tests. Every alignment cycle writes a
# few; they are evidence for a commit message, not part of the suite, and one
# nearly landed as a tmp-*.test.ts. Give them a home that git ignores.
# At the ROOT, deliberately: under tests/ every tool that walks that directory
# found them and each needed its own exclude. See vitest.probes.config.ts.
.probes/

# The probe SFC a vue-tsc gap check wrote into an example. That script is gone,
# but the pattern stays - a killed run of any successor probe must still be
# unable to commit deliberately broken code into an example.
**/__vue_tsc_gap_probe.vue
