{
  // Compile-time contract tests (GlobalCommands augmentation etc.).
  // Separate program: the augmentation must not leak into the build emit,
  // and rootDir "src" excludes tests/ from the main project.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false
  },
  // The `*.test-d.ts` files are matched by nothing else: not vitest (`include:
  // tests/**/*.test.ts` does not match `.test-d.ts`), not the main project
  // (`rootDir: "src"` excludes tests/), not tsconfig.tests.json (it excludes
  // them). They assert via `@ts-expect-error` (e.g. that a typo'd route name
  // must not compile), so a file left out of this list is a compile-time guard
  // that never compiles.
  "include": [
    "src/**/*",
    "tests/typed-contract.typecheck.ts",
    "tests/router/typed-names.test-d.ts",
    "tests/csrf-option.test-d.ts",
    "tests/option-types.test-d.ts",
    "tests/vapor-signal-types.test-d.ts"
  ]
}
