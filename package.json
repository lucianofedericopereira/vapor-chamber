{
  "name": "vapor-chamber",
  "version": "1.22.0",
  "description": "Lightweight command bus for Vue Vapor - plugins, hooks, undo/redo, Vue 3.6 Vapor aligned",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./vapor": {
      "types": "./dist/vapor.d.ts",
      "import": "./dist/vapor.js",
      "default": "./dist/vapor.js"
    },
    "./transports": {
      "types": "./dist/transports.d.ts",
      "import": "./dist/transports.js",
      "default": "./dist/transports.js"
    },
    "./directives": {
      "types": "./dist/directives.d.ts",
      "import": "./dist/directives.js",
      "default": "./dist/directives.js"
    },
    "./vite": {
      "types": "./dist/vite-hmr.d.ts",
      "import": "./dist/vite-hmr.js",
      "default": "./dist/vite-hmr.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js",
      "default": "./dist/vitest.js"
    },
    "./vitest/pure": {
      "types": "./dist/vitest-pure.d.ts",
      "import": "./dist/vitest-pure.js",
      "default": "./dist/vitest-pure.js"
    },
    "./vitest/mcp": {
      "types": "./dist/vitest-mcp.d.ts",
      "import": "./dist/vitest-mcp.js",
      "default": "./dist/vitest-mcp.js"
    },
    "./transitions": {
      "types": "./dist/transitions.d.ts",
      "import": "./dist/transitions.js",
      "default": "./dist/transitions.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.js",
      "default": "./dist/ssr.js"
    },
    "./fast-lane": {
      "types": "./dist/fast-lane.d.ts",
      "import": "./dist/fast-lane.js",
      "default": "./dist/fast-lane.js"
    },
    "./observable": {
      "types": "./dist/observable.d.ts",
      "import": "./dist/observable.js",
      "default": "./dist/observable.js"
    },
    "./standard-schema": {
      "types": "./dist/plugins-schema.d.ts",
      "import": "./dist/plugins-schema.js",
      "default": "./dist/plugins-schema.js"
    },
    "./alien-signals": {
      "types": "./dist/alien-signals.d.ts",
      "import": "./dist/alien-signals.js",
      "default": "./dist/alien-signals.js"
    },
    "./reactive": {
      "types": "./dist/reactive.d.ts",
      "import": "./dist/reactive.js",
      "default": "./dist/reactive.js"
    },
    "./outbox": {
      "types": "./dist/outbox.d.ts",
      "import": "./dist/outbox.js",
      "default": "./dist/outbox.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "default": "./dist/devtools.js"
    },
    "./stream-parser": {
      "types": "./dist/stream-parser.d.ts",
      "import": "./dist/stream-parser.js",
      "default": "./dist/stream-parser.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js",
      "default": "./dist/store.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js",
      "default": "./dist/router/index.js"
    },
    "./router/vdom": {
      "types": "./dist/router/vdom.d.ts",
      "import": "./dist/router/vdom.js",
      "default": "./dist/router/vdom.js"
    },
    "./router/vapor": {
      "types": "./dist/router/vapor.d.ts",
      "import": "./dist/router/vapor.js",
      "default": "./dist/router/vapor.js"
    },
    "./router/remote": {
      "types": "./dist/router/remote.d.ts",
      "import": "./dist/router/remote.js",
      "default": "./dist/router/remote.js"
    },
    "./router-fetch": {
      "types": "./dist/router-fetch/index.d.ts",
      "import": "./dist/router-fetch/index.js",
      "default": "./dist/router-fetch/index.js"
    },
    "./iife": {
      "types": "./dist/iife.d.ts",
      "import": "./dist/iife.js",
      "default": "./dist/iife.js"
    },
    "./iife-core": {
      "types": "./dist/iife-core.d.ts",
      "import": "./dist/iife-core.js",
      "default": "./dist/iife-core.js"
    },
    "./iife-elements": {
      "types": "./dist/iife-elements.d.ts",
      "import": "./dist/iife-elements.js",
      "default": "./dist/iife-elements.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vc-vitest-mcp": "./bin/vc-vitest-mcp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "scripts",
    "ROADMAP.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/vue.js",
    "./dist/vapor.js",
    "./dist/vitest.js",
    "./dist/iife.js",
    "./dist/iife-core.js",
    "./dist/iife-elements.js",
    "./dist/*.iife.js",
    "./dist/*.iife.min.js"
  ],
  "scripts": {
    "prepare": "npm run build",
    "version": "npm run docs && npm run coverage:doc && npm run docs:stamp && git add docs README.md",
    "build": "tsc && node scripts/build.mjs",
    "build:types": "tsc",
    "build:js": "node scripts/build.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.typecheck.json && tsc -p tsconfig.tests.json && tsc -p examples/tsconfig.patterns.json",
    "lint": "biome check --write src tests scripts bin",
    "lint:check": "biome check src tests scripts bin && node scripts/check-env-guards.mjs && node scripts/check-console-shape.mjs && node scripts/check-line-citations.mjs && node scripts/check-doc-claims.mjs && node scripts/stamp-docs.mjs --check && node scripts/check-ascii.mjs",
    "docs:stamp": "node scripts/stamp-docs.mjs",
    "docs:check": "node scripts/stamp-docs.mjs --check",
    "test": "vitest run && vitest run -c vitest.vapor.config.ts",
    "test:vapor": "vitest run -c vitest.vapor.config.ts",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run tests/perf.bench.ts --reporter=default --reporter=./scripts/bench-ratios-reporter.mjs",
    "ab:vue": "node scripts/ab-vue.mjs",
    "size:check": "node scripts/check-size.mjs",
    "gate": "node scripts/gate.mjs",
    "size": "node scripts/measure-size.mjs",
    "size:doc": "node scripts/measure-size.mjs --md > docs/BUNDLE-SIZES.md",
    "coverage": "node scripts/measure-coverage.mjs",
    "coverage:doc": "vitest run --coverage && node scripts/measure-coverage.mjs --md > docs/COVERAGE.md",
    "check:example": "npm --prefix examples/vapor-sfc run build && node scripts/check-example-directive.mjs && npm --prefix examples/vapor-island-cart run build",
    "loc": "node scripts/measure-loc.mjs src",
    "docs": "node scripts/generate-api-docs.mjs",
    "docs:serve": "node scripts/serve-docs.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test:run && npm run test:vapor && npm run size:check && npm run lint:check && npm run test:coverage"
  },
  "keywords": [
    "vue",
    "vapor",
    "vue-vapor",
    "command-bus",
    "commands",
    "plugins",
    "middleware",
    "undo-redo",
    "state-management",
    "signals",
    "reactive",
    "alien-signals",
    "vue-3.6",
    "vapor-mode",
    "router",
    "laravel",
    "blade",
    "pagination"
  ],
  "author": "Luciano Federico Pereira",
  "license": "LGPL-2.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucianofedericopereira/vapor-chamber.git"
  },
  "bugs": {
    "url": "https://github.com/lucianofedericopereira/vapor-chamber/issues"
  },
  "homepage": "https://github.com/lucianofedericopereira/vapor-chamber#readme",
  "peerDependencies": {
    "@vitejs/plugin-vue": ">=5.0.0",
    "@vue/devtools-api": ">=6.0.0",
    "@vue/reactivity": ">=3.5.0 || >=3.6.0-rc.9",
    "alien-signals": ">=3.1.2",
    "vite": ">=5.0.0",
    "vitest": ">=5.0.0",
    "vue": ">=3.5.0 || >=3.6.0-rc.9"
  },
  "peerDependenciesMeta": {
    "alien-signals": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@vue/devtools-api": {
      "optional": true
    },
    "@vitejs/plugin-vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@vue/reactivity": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/devtools-api": "^8.1.5",
    "@vue/reactivity": "^3.6.0-rc.9",
    "@vue/runtime-vapor": "^3.6.0-rc.9",
    "alien-signals": "^3.1.2",
    "esbuild": "^0.28.2",
    "eventemitter3": "^5.0.4",
    "happy-dom": "^20.11.2",
    "mitt": "^3.0.1",
    "nanoevents": "^9.1.0",
    "rxjs": "^7.8.2",
    "tiny-emitter": "^2.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.1",
    "vue": "^3.6.0-rc.9"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "examples/exo-astro",
    "examples/vapor-island-cart",
    "examples/vapor-sfc"
  ],
  "overrides": {
    "@vitejs/plugin-vue": {
      "vue": "$vue"
    }
  }
}
