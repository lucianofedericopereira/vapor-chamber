{
  // Type-checks the top-level example/pattern reference snippets against the
  // real library types (paths below map straight into ../src). Nothing else
  // runs these files - they are not built or tested - so this is what catches
  // an example misusing the library's own API. examples/patterns-ambient.d.ts
  // stubs the imports a real project would have (a .vue file, Inertia).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"],
    "paths": {
      "vapor-chamber": ["../src/index.ts"],
      "vapor-chamber/vite": ["../src/vite-hmr.ts"],
      "vapor-chamber/standard-schema": ["../src/plugins-schema.ts"],
      "vapor-chamber/*": ["../src/*"]
    }
  },
  // A glob, so an example added tomorrow is checked too. Not checked here,
  // each for its reason:
  //   *.html                 - pattern-1-blade-cdn, feature-directives: HTML
  //   vue-vapor-component.vue - an SFC, which plain tsc cannot read: the
  //                             vapor-sfc example's vue-tsc checks it
  "include": ["*.ts", "patterns-ambient.d.ts"],
  "exclude": [
    // Checked by tsconfig.pattern-4.json: it needs JSX and @types/react alone
    // (19.3.0, "types": ["react"]). react-dom is not needed (measured
    // 2026-10-08).
    "pattern-4-nextjs.tsx",
    // Not a snippet: the shared Vite config factory, and each example's own
    // `vue-tsc` already type-checks it during that example's build.
    "vite.base.ts"
  ]
}
